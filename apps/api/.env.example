# Stewra API — copy to .env for local development
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://stewra:stewra@localhost:5432/stewra
# at least 32 random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=
CORS_ORIGINS=http://localhost:3000
AUTH_DOMAIN=localhost:3000

# Agent execution (Claude). Without a key, tasks fail with a clear "provider not configured" error.
ANTHROPIC_API_KEY=
DEFAULT_MODEL=claude-opus-5-5
# Local development only: produce clearly labelled [MOCK] output instead of calling a model.
AGENT_MOCK_MODE=false
WORKER_ENABLED=true
WORKER_CONCURRENCY=2

# Robinhood Chain (testnet by default)
CHAIN_ID=46630
RPC_URL=https://rpc.testnet.chain.robinhood.com
EXPLORER_URL=
# Fill these after deploying packages/contracts (see docs/DEPLOYMENT.md)
ESCROW_ADDRESS=
BUSINESS_REGISTRY_ADDRESS=
SETTLEMENT_TOKEN_ADDRESS=
SETTLEMENT_TOKEN_SYMBOL=tUSD
SETTLEMENT_TOKEN_DECIMALS=6

PLATFORM_FEE_BPS=0
QUOTE_TTL_MINUTES=30
